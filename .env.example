# =============================================================================
# MarketMitra — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
#
# Every variable here is validated at boot by src/lib/env.ts — if a required
# value is missing or malformed, the app will refuse to start with a clear
# error message telling you exactly what's wrong.
#
# See docs/SETUP.md for step-by-step instructions on obtaining each key.
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=MarketMitra


# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
# Pooled connection (used at runtime, e.g. via PgBouncer / Neon / Supabase pooler)
DATABASE_URL=postgresql://user:password@localhost:5432/marketmitra?schema=public

# Direct (non-pooled) connection — required by `prisma migrate` on serverless
# Postgres providers. If your DB doesn't pool connections, set this to the
# same value as DATABASE_URL.
DIRECT_URL=postgresql://user:password@localhost:5432/marketmitra?schema=public


# -----------------------------------------------------------------------------
# Auth / Sessions
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-real-32-plus-character-secret
SESSION_COOKIE_NAME=marketmitra_session
SESSION_MAX_AGE_DAYS=30


# -----------------------------------------------------------------------------
# Email (transactional — verification, password reset, invoices, notifications)
# -----------------------------------------------------------------------------
# Choose ONE provider.
EMAIL_PROVIDER=resend

# --- Resend (recommended) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SMTP (alternative) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=replace-with-real-smtp-password

EMAIL_FROM="MarketMitra <noreply@marketmitra.ai>"

# Destination inbox for the public /contact form. Optional — submissions
# are logged (not emailed) until this is set.
CONTACT_INBOX_EMAIL=


# -----------------------------------------------------------------------------
# AI Provider Layer
# -----------------------------------------------------------------------------
# Default provider used when a workspace has no explicit override.
# One of: openai | anthropic | gemini | grok | deepseek
AI_PROVIDER=anthropic

# Only the key matching AI_PROVIDER is strictly required at boot.
# Set additional keys to allow workspaces to opt into other providers.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Billing — Razorpay (primary gateway, India)
# -----------------------------------------------------------------------------
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-real-razorpay-secret

# Dashboard → Settings → Webhooks → Webhook Secret
# Register webhook URL: {APP_URL}/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=replace-with-real-webhook-secret


# -----------------------------------------------------------------------------
# Billing — Stripe (secondary gateway, international)
# -----------------------------------------------------------------------------
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Dashboard → Developers → Webhooks → Signing Secret
# Register webhook URL: {APP_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# File Storage (logo uploads, brand assets, generated content exports)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=s3

S3_BUCKET_NAME=marketmitra-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
S3_SECRET_ACCESS_KEY=replace-with-real-secret-access-key
S3_PUBLIC_URL=https://marketmitra-uploads.s3.ap-south-1.amazonaws.com


# -----------------------------------------------------------------------------
# Rate limiting / caching
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# PRODUCTION REQUIRES REDIS_URL and ONE trusted client-IP source below; the app refuses to start without them (docs/RATE_LIMITING.md).
# Which client-IP information the rate limiter may trust. Set exactly ONE that matches your deployment, and only if clients cannot
# reach the app directly (never x-forwarded-for as a header name: use TRUSTED_PROXY_HOPS for that):
#   TRUSTED_IP_HEADER=x-real-ip      a header your edge/proxy OVERWRITES with the client IP (cf-connecting-ip, x-real-ip, ...)
#   TRUSTED_PROXY_HOPS=1             number of reverse proxies that APPEND to x-forwarded-for
TRUSTED_IP_HEADER=
TRUSTED_PROXY_HOPS=0

# Explicit acknowledgements, ONLY for a deliberate setup without the above (each prints a warning at boot):
#   RATE_LIMIT_ALLOW_UNTRUSTED_CLIENT_IP=true   no proxy: every client shares one bucket per endpoint
#   RATE_LIMIT_ALLOW_MEMORY_STORE=true          single instance, no Redis: limits are per process and reset on restart
# RATE_LIMIT_ALLOW_UNTRUSTED_CLIENT_IP=false
# RATE_LIMIT_ALLOW_MEMORY_STORE=false

# What the limiter does when Redis is unreachable: "memory" (default; keep enforcing per instance) or "deny" (503, fail closed).
# Applies to the public endpoints AND to AI execution (cost control): neither is ever unlimited.
RATE_LIMIT_ON_STORE_FAILURE=memory

# Optional JSON override of the thresholds (strict and validated at boot). Example: raise the login per-IP limit only.
# RATE_LIMIT_POLICY_JSON={"login":{"ip":{"max":60}}}


# -----------------------------------------------------------------------------
# Monitoring / Logging
# -----------------------------------------------------------------------------
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Feature flags (platform defaults — can be overridden per-workspace in DB)
# -----------------------------------------------------------------------------
ENABLE_SIGNUPS=true
ENABLE_REFERRALS=true
